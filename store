                                <span class="text-[10px] font-bold text-slate-400">ج.م</span>
                            </div>
                            <button onclick="addToCart(${book.id})" class="px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-russian-600 hover:text-white dark:hover:bg-russian-600 text-slate-700 dark:text-slate-200 text-xs font-bold transition-all flex items-center gap-1.5">
                                <i class="fa-solid fa-cart-plus"></i>
                                <span>إضافة</span>
                            </button>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function getCategoryLabel(cat) {
            switch(cat) {
                case 'novels': return 'رواية';
                case 'study': return 'دراسي';
                case 'notes': return 'مذكرة';
                default: return 'كتاب ورقي';
            }
        }

        // Filter Categories
        function filterCategory(cat) {
            document.querySelectorAll('.category-btn').forEach(btn => {
                btn.classList.remove('bg-russian-600', 'text-white', 'border-russian-600', 'shadow-md');
                btn.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');
            });
            event.target.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');
            event.target.classList.add('bg-russian-600', 'text-white', 'border-russian-600', 'shadow-md');

            if (cat === 'all') {
                renderBooks(books);
            } else {
                const filtered = books.filter(b => b.category === cat);
                renderBooks(filtered);
            }
        }

        // Handle Search Inputs
        function handleSearch() {
            const query = document.getElementById('search-input').value.toLowerCase().trim();
            const filtered = books.filter(b => b.title.toLowerCase().includes(query) || b.author.toLowerCase().includes(query));
            renderBooks(filtered);
        }

        function handleSearchMobile() {
            const query = document.getElementById('search-input-mobile').value.toLowerCase().trim();
            const filtered = books.filter(b => b.title.toLowerCase().includes(query) || b.author.toLowerCase().includes(query));
            renderBooks(filtered);
        }

        // Cart Drawer Logic
        function toggleCart() {
            const drawer = document.getElementById('cart-drawer');
            const overlay = document.getElementById('cart-drawer-overlay');
            
            if (drawer.classList.contains('-translate-x-full')) {
                drawer.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
            } else {
                drawer.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            }
        }

        function addToCart(bookId) {
            const book = books.find(b => b.id === bookId);
            const existing = cart.find(item => item.id === bookId);

            if (existing) {
                existing.qty += 1;
            } else {
                cart.push({ ...book, qty: 1 });
            }

            saveCart();
            updateCartUI();
            showToast(`تمت إضافة "${book.title}" للسلة`);
        }

        function updateCartQuantity(bookId, delta) {
            const item = cart.find(i => i.id === bookId);
            if (!item) return;

            item.qty += delta;
            if (item.qty <= 0) {
                cart = cart.filter(i => i.id !== bookId);
            }

            saveCart();
            updateCartUI();
        }

        function saveCart() {
            localStorage.setItem('russian_cart', JSON.stringify(cart));
        }

        function updateCartUI() {
            const container = document.getElementById('cart-items-container');
            const countBadge = document.getElementById('cart-count');
            const subtotalEl = document.getElementById('cart-subtotal');
            const totalEl = document.getElementById('cart-total');

            container.innerHTML = '';
            let totalCount = 0;
            let totalPrice = 0;

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-slate-400 space-y-3">
                        <i class="fa-solid fa-basket-shopping text-4xl"></i>
                        <p class="text-xs font-bold">السلة فارغة حالياً</p>
                    </div>
                `;
            } else {
                cart.forEach(item => {
                    totalCount += item.qty;
                    totalPrice += item.price * item.qty;

                    const row = document.createElement('div');
                    row.className = "flex items-center justify-between p-3 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 gap-3";
                    row.innerHTML = `
                        <img src="${item.image}" class="w-12 h-16 object-cover rounded-lg">
                        <div class="flex-1 min-w-0">
                            <h4 class="text-xs font-bold truncate text-slate-900 dark:text-white">${item.title}</h4>
                            <p class="text-[11px] text-russian-600 dark:text-russian-400 font-bold mt-1">${item.price} ج.م × ${item.qty}</p>
                        </div>
                        <div class="flex items-center gap-2 bg-white dark:bg-slate-900 px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-700">
                            <button onclick="updateCartQuantity(${item.id}, -1)" class="text-slate-400 hover:text-rose-500 px-1 text-xs font-bold">-</button>
                            <span class="text-xs font-bold w-4 text-center">${item.qty}</span>
                            <button onclick="updateCartQuantity(${item.id}, 1)" class="text-slate-400 hover:text-emerald-500 px-1 text-xs font-bold">+</button>
                        </div>
                    `;
                    container.appendChild(row);
                });
            }

            countBadge.innerText = totalCount;
            subtotalEl.innerText = `${totalPrice} ج.م`;
            totalEl.innerText = `${totalPrice} ج.م`;
        }

        // Checkout & Telegram Order Submission
        async function handleCheckout(event) {
            event.preventDefault();

            if (cart.length === 0) {
                alert('سلة التسوق فارغة! من فضلك أضف بعض الكتب أولاً.');
                return;
            }

            const name = document.getElementById('cust-name').value.trim();
            const phone = document.getElementById('cust-phone').value.trim();
            const address = document.getElementById('cust-address').value.trim();
            const notes = document.getElementById('cust-notes').value.trim();

            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            // Build Order Summary Message Text for Telegram
            let orderText = `📚 *أوردر جديد من مكتبة الروسي* 📚\n\n`;
            orderText += `👤 *العميل:* ${name}\n`;
            orderText += `📞 *الهاتف:* ${phone}\n`;
            orderText += `📍 *العنوان:* ${address}\n`;
            if (notes) orderText += `📝 *ملاحظات:* ${notes}\n`;
            orderText += `---------------------------------\n`;
            orderText += `📖 *الكتب المطلوبة:*\n`;

            cart.forEach((item, index) => {
                orderText += `${index + 1}. ${item.title} (العدد: ${item.qty}) - ${item.price * item.qty} ج.م\n`;
            });

            orderText += `---------------------------------\n`;
            orderText += `💰 *الإجمالي النهائي:* ${totalPrice} جنيه مصري`;

            // Telegram Sending Option 1: Bot API (if configured)
            if (telegramSettings.botToken && telegramSettings.chatId) {
                const btn = document.getElementById('submit-order-btn');
                btn.disabled = true;
                btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> جاري إرسال الطلب...`;

                try {
                    const response = await fetch(`https://api.telegram.org/bot${telegramSettings.botToken}/sendMessage`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            chat_id: telegramSettings.chatId,
                            text: orderText,
                            parse_mode: 'Markdown'
                        })
                    });

                    if (response.ok) {
                        alert('✅ تم إرسال الطلب بنجاح لمكتبة الروسي وسيتم التواصل معك فوراً!');
                        cart = [];
                        saveCart();
                        updateCartUI();
                        toggleCart();
                    } else {
                        throw new Error('فشل الإرسال عبر البوت');
                    }
                } catch (error) {
                    alert('تعذر الإرسال الآلي، سيتم تحويلك لرابط التليجرام المباشر بدلاً من ذلك.');
                    openDirectTelegramLink(orderText);
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = `<i class="fa-brands fa-telegram text-lg"></i> <span>إرسال الطلب عبر تليجرام</span>`;
                }
            } else {
                // Telegram Sending Option 2: Direct Username URL Link
                openDirectTelegramLink(orderText);
                cart = [];
                saveCart();
                updateCartUI();
                toggleCart();
            }
        }

        function openDirectTelegramLink(text) {
            const target = telegramSettings.directUsername || 'RussianLibrary';
            const encodedText = encodeURIComponent(text);
            window.open(`https://t.me/${target}?text=${encodedText}`, '_blank');
        }

        // Telegram Settings Modal Functions
        function openTelegramModal() {
            document.getElementById('telegram-direct-username').value = telegramSettings.directUsername || '';
            document.getElementById('tg-bot-token').value = telegramSettings.botToken || '';
            document.getElementById('tg-chat-id').value = telegramSettings.chatId || '';
            document.getElementById('telegram-modal').classList.remove('hidden');
        }

        function closeTelegramModal() {
            document.getElementById('telegram-modal').classList.add('hidden');
        }

        function saveTelegramSettings() {
            telegramSettings.directUsername = document.getElementById('telegram-direct-username').value.trim() || 'RussianLibrary';
            telegramSettings.botToken = document.getElementById('tg-bot-token').value.trim();
            telegramSettings.chatId = document.getElementById('tg-chat-id').value.trim();

            localStorage.setItem('russian_tg_settings', JSON.stringify(telegramSettings));
            checkTelegramConfig();
            closeTelegramModal();
            showToast('تم حفظ إعدادات التليجرام بنجاح');
        }

        function checkTelegramConfig() {
            const indicator = document.getElementById('telegram-indicator');
            if (telegramSettings.botToken && telegramSettings.chatId) {
                indicator.classList.remove('hidden');
            } else {
                indicator.classList.add('hidden');
            }
        }

        // Helper Toast Notification
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = msg;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 2500);
        }
    </script>
</body>
</html>
